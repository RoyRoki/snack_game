{
  "buildCommand": null,
  "outputDirectory": "web",
  "framework": null,
  "headers": [
    {
      "source": "/pkg/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type",  "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/pkg/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
